1 ICON "@ICON@"

1 VERSIONINFO
FILEVERSION @FILEVERSION@
PRODUCTVERSION @FILEVERSION@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Artem Letyushev\0"
            VALUE "FileDescription", "pane-md Markdown editor\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "InternalName", "pane-md\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Artem Letyushev\0"
            VALUE "OriginalFilename", "pane-md.exe\0"
            VALUE "ProductName", "pane-md\0"
            VALUE "ProductVersion", "@VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
